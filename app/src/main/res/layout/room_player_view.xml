<?xml version="1.0" encoding="utf-8"?>
<!--
  Reproductor del video de fondo de una habitación. TextureView (no SurfaceView) para que se dibuje dentro
  de la jerarquía normal y respete el recorte; sin controles. El tamaño y el recorte (cubrir toda la
  pantalla) los calcula VideoBackground, así que aquí el video simplemente llena la vista.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fill" />
